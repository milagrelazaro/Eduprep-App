# Google Gemini API Key para processamento de exames com IA
GEMINI_API_KEY=your_gemini_api_key_here
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Backend API URL (quando criar o backend)
API_URL=http://localhost:3000

# DPO PayGate (quando configurar pagamentos)
DPO_COMPANY_TOKEN=your_dpo_token_here
DPO_SERVICE_TYPE=5525

# M-Pesa (opcional - se integrar diretamente)
MPESA_API_KEY=your_mpesa_key_here
MPESA_SERVICE_CODE=your_service_code_here

# e-Mola (opcional - se integrar diretamente)
EMOLA_API_KEY=your_emola_key_here
